  "cards": [
    {
      "dot": "rose",
      "title": "Nơi diễn ra suy luận bảo mật",
      "items": [
        "Chức năng: chọn bằng chứng có thứ tự và ánh xạ hành vi quan sát được; Đầu vào: incident/evidence; Đầu ra: timeline + liên kết technique.",
        "Kiến thức: evidence so với hypothesis, IOC/TTP, ánh xạ ATT&CK và giải thích severity.",
        "Cần học trước: câu hỏi điều tra cơ bản và ánh xạ có bằng chứng; Học sau — Mở rộng tương lai: playbook đầy đủ; Độ sâu: Cơ bản."
      ]
    },
    {
      "dot": "violet",
      "title": "Nơi diễn ra suy luận RAG / LLM",
      "items": [
        "Retriever: trả về chunk tin cậy, có phiên bản và trích dẫn từ dữ kiện incident xác định",
        "LLM Copilot: tổng hợp tóm tắt, giả thuyết và bước tiếp theo từ evidence/ngữ cảnh được cung cấp",
        "Cần học trước: truy vết citation và phân biệt fact/hypothesis; Học sau — Mở rộng tương lai: hybrid retrieval hoặc SOC đa tác tử; Độ sâu: Bảo mật cơ bản."
      ]
    },
    {
      "dot": "amber",
      "title": "Nơi diễn ra validation xác định",
      "items": [
        "Validator kiểm tra cấu trúc, evidence ID, citation, technique ID được phép và ngôn ngữ thể hiện độ không chắc chắn",
        "Event, IOC, technique hoặc root cause bị bịa sẽ chặn việc lưu",
        "Đầu ra chỉ được lưu sau khi cổng xác định trả về hợp lệ"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ranh giới giữa các lớp",
      "items": [
        "Detection, correlation, tạo incident và ánh xạ ATT&CK diễn ra trước trình tự này",
        "RAG cung cấp tri thức; LLM cung cấp bản nháp",
        "Báo cáo vẫn là Đề xuất cho đến khi việc triển khai ứng dụng được phê duyệt"
      ]
    }
  ]
