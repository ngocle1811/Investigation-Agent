  "messages": [
    {
      "id": "investigate",
      "from": "trigger_api",
      "to": "incident_service",
      "y": 180,
      "label": "investigate(incident_id)",
      "variant": "emphasis",
      "note": "Đầu vào: mã định danh incident"
    },
    {
      "id": "load_incident_evidence",
      "from": "incident_service",
      "to": "event_store",
      "y": 225,
      "label": "nạp incident + evidence ID",
      "variant": "security",
      "note": "Tra cứu xác định"
    },
    {
      "id": "return_evidence",
      "from": "event_store",
      "to": "incident_service",
      "y": 270,
      "label": "incident + bằng chứng có thứ tự",
      "variant": "return",
      "note": "Dữ kiện nguồn và timeline"
    },
    {
      "id": "map_mitre",
      "from": "incident_service",
      "to": "mitre_mapper",
      "y": 315,
      "label": "ánh xạ hành vi quan sát được",
      "variant": "security",
      "note": "Suy luận bảo mật: quy tắc evidence-to-technique"
    },
    {
      "id": "return_mitre",
      "from": "mitre_mapper",
      "to": "incident_service",
      "y": 355,
      "label": "technique ID + liên kết bằng chứng",
      "variant": "return",
      "note": "Không để LLM đoán từ raw log"
    },
    {
      "id": "retrieve",
      "from": "incident_service",
      "to": "retriever",
      "y": 400,
      "label": "retrieve(technique, thực thể)",
      "variant": "dashed",
      "note": "Truy vấn có căn cứ"
    },
    {
      "id": "vector_search",
      "from": "retriever",
      "to": "vector_store",
      "y": 445,
      "label": "tìm kiếm kèm bộ lọc metadata",
      "variant": "dashed",
      "note": "technique_id, source, version, reference"
    },
    {
      "id": "return_chunks",
      "from": "vector_store",
      "to": "retriever",
      "y": 485,
      "label": "chunk có trích dẫn đã xếp hạng",
      "variant": "return",
      "note": "Tri thức, không phải detection"
    },
    {
      "id": "return_context",
      "from": "retriever",
      "to": "incident_service",
      "y": 525,
      "label": "ngữ cảnh truy xuất + citation",
      "variant": "return"
    },
    {
      "id": "generate",
      "from": "incident_service",
      "to": "llm_copilot",
      "y": 575,
      "label": "prompt có căn cứ + hợp đồng evidence",
      "variant": "dashed",
      "note": "Suy luận LLM chỉ diễn ra tại đây"
    },
    {
      "id": "return_draft",
      "from": "llm_copilot",
      "to": "incident_service",
      "y": 620,
      "label": "bản nháp báo cáo có cấu trúc",
      "variant": "return",
      "note": "Fact, hypothesis, confidence và bước tiếp theo"
    },
    {
      "id": "validate_draft",
      "from": "incident_service",
      "to": "validator",
      "y": 665,
      "label": "kiểm tra schema + nhận định có căn cứ",
      "variant": "security",
      "note": "Validation xác định diễn ra tại đây"
    },
    {
      "id": "return_valid",
      "from": "validator",
      "to": "incident_service",
      "y": 710,
      "label": "báo cáo hợp lệ hoặc lỗi rõ ràng",
      "variant": "return",
      "note": "Từ chối event/IOC/technique/root cause bị bịa"
    },
    {
      "id": "save_report",
      "from": "incident_service",
      "to": "report_store",
      "y": 748,
      "label": "lưu báo cáo đã kiểm định",
      "variant": "emphasis"
    },
    {
      "id": "save_ack",
      "from": "report_store",
      "to": "incident_service",
      "y": 782,
      "label": "report_id",
      "variant": "return"
    },
    {
      "id": "return_report",
      "from": "incident_service",
      "to": "trigger_api",
      "y": 815,
      "label": "báo cáo + citation",
      "variant": "return"
    }
